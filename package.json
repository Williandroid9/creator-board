{
  "name": "creator-board",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "desktop": "npm run build && electron .",
    "desktop:open": "electron .",
    "dist:desktop": "npm run build && electron-builder --win --dir --publish never",
    "dist:desktop:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:desktop:installer": "npm run build && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --configLoader runner",
    "web:build": "npm run build",
    "web:preview": "vite preview --host 127.0.0.1 --port 4173 --configLoader runner",
    "standalone": "tailwindcss -i ./src/index.css -o ./dist/assets/creator-board.css --minify && node ./scripts/build-standalone.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "com.creatorboard.desktop",
    "productName": "Creator Board",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
